{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=your_db;Username=your_user;Password=your_password"
  },

  "Jwt": {
    "Secret": "your-secret-key",
    "Issuer": "SmartStudy",
    "Audience": "SmartStudyClient",
    "ExpiryMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },

  "OpenStreetMapImport": {
    "Enabled": false,
    "BaseUrl": "https://overpass-api.de/api/interpreter",
    "MaxPlacesPerArea": 150,
    "BatchSize": 50,
    "MaxRetries": 3,
    "RetryDelaySeconds": 2,
    "Areas": [
      {
        "Name": "District1-Sample",
        "South": 10.7680,
        "West": 106.6930,
        "North": 10.7780,
        "East": 106.7050
      }
    ]
  }
}